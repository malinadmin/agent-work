# 钉钉开发者后台：企业内部应用 → 机器人 → Stream 模式
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 允许使用者的 senderStaffId，多个以英文逗号分隔；必须配置
DINGTALK_ALLOWED_USERS=
# 可选：进一步限制 conversationId，多个以英文逗号分隔
DINGTALK_ALLOWED_CONVERSATIONS=

# 留空使用 PATH 中的 codex；如果 PATH 找不到请填写绝对路径
DING_CODEX_BIN=codex
DING_CODEX_WORKDIR=/Users/mamalin/Documents/code/ding-cli
# 默认只读；需要修改项目时可设 workspace-write
DING_CODEX_SANDBOX=read-only
# 留空沿用本机 Codex 配置
DING_CODEX_MODEL=
# 可选：新聊天绑定到指定的已有会话 UUID；留空则自动新建
# 同一会话请避免同时在桌面端和机器人端发起任务
DING_CODEX_SESSION_ID=
DING_CODEX_TIMEOUT_MS=600000
STATE_FILE=.data/state.json
